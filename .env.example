# =============================================================================
# Tixly — Environment Variables
# Zkopíruj do .env.local (Next.js) nebo .env (lokální vývoj)
# NIKDY necommituj .env s ostrými hodnotami!
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tixly
POSTGRES_USER=tixly
POSTGRES_PASSWORD=tixly_dev
DATABASE_URL=postgresql://tixly:tixly_dev@localhost:5432/tixly

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev
REDIS_URL=redis://:redis_dev@localhost:6379

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=tixly-api

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-min-32-chars-for-hs256-please
JWT_ACCESS_TOKEN_TTL=900         # 15 minut (sekundy)
JWT_REFRESH_TOKEN_TTL=604800     # 7 dní (sekundy)

# -----------------------------------------------------------------------------
# GoPay (vyplnit po získání IČO)
# -----------------------------------------------------------------------------
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_GOID=
GOPAY_API_URL=https://gw.sandbox.gopay.com/api

# ─── Email (Amazon SES) ───
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=vstupenky@tixly.cz

# For dev without SES: leave SMTP_HOST empty and emails will print to console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@tixly.cz

# -----------------------------------------------------------------------------
# Apple Wallet (wallet-passes modul)
# -----------------------------------------------------------------------------
APPLE_PASS_TYPE_IDENTIFIER=pass.cz.tixly
APPLE_TEAM_IDENTIFIER=
APPLE_CERT_P12_BASE64=
APPLE_CERT_P12_PASSWORD=
APPLE_APN_KEY_ID=
APPLE_APN_KEY_BASE64=

# -----------------------------------------------------------------------------
# Google Wallet
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_ISSUER_ID=

# -----------------------------------------------------------------------------
# Meta Conversions API (server-side-tracking)
# -----------------------------------------------------------------------------
META_PIXEL_ID=
META_ACCESS_TOKEN=

# TikTok Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Aplikace
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
