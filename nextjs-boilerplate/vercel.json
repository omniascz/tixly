{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "nextjs",

  "regions": ["fra1"],

  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],

  "crons": [
    { "path": "/api/cron/dispatch?job=expire-pending-orders", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/dispatch?job=release-expired-seat-holds", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/dispatch?job=send-reminders", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/dispatch?job=abandoned-cart", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/dispatch?job=waitlist-notify", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/dispatch?job=bank-sync-fio", "schedule": "0 */2 * * *" },
    { "path": "/api/cron/dispatch?job=charge-installments", "schedule": "0 3 * * *" },
    { "path": "/api/cron/dispatch?job=renew-subscriptions", "schedule": "0 4 * * *" },
    { "path": "/api/cron/dispatch?job=daily-stats", "schedule": "0 6 * * *" },
    { "path": "/api/cron/dispatch?job=onboarding-reminder", "schedule": "0 9 * * *" },
    { "path": "/api/cron/dispatch?job=process-gdpr-deletions", "schedule": "0 2 * * *" },
    { "path": "/api/cron/dispatch?job=anomaly-detect", "schedule": "0 * * * *" },
    { "path": "/api/cron/dispatch?job=release-rolling-reserves", "schedule": "0 5 * * *" },
    { "path": "/api/cron/dispatch?job=promoter-tier-evaluate", "schedule": "0 1 1 * *" },
    { "path": "/api/cron/dispatch?job=payouts-auto-settle", "schedule": "0 7 * * 1" },
    { "path": "/api/cron/dispatch?job=consent-log-purge", "schedule": "0 4 * * 1" },
    { "path": "/api/cron/dispatch?job=newsletter-digest", "schedule": "0 9 * * 1" },
    { "path": "/api/cron/dispatch?job=verify-event-completion", "schedule": "0 8 * * *" },
    { "path": "/api/cron/dispatch?job=recompute-dynamic-pricing", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/dispatch?job=refresh-spotify", "schedule": "*/50 * * * *" },
    { "path": "/api/cron/dispatch?job=music-distribute", "schedule": "*/20 * * * *" },
    { "path": "/api/cron/dispatch?job=send-commemorative", "schedule": "0 10 * * *" },
    { "path": "/api/cron/dispatch?job=forgemsg-dispatch", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/dispatch?job=forgemsg-sync-events", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/dispatch?job=forgemsg-provision", "schedule": "0 * * * *" },
    { "path": "/api/admin/lastminute/check", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/dispatch?job=event-payout-release", "schedule": "0 8 * * *" },
    { "path": "/api/cron/dispatch?job=release-group-invite-holds", "schedule": "*/10 * * * *" }
  ]
}
