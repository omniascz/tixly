NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXTAUTH_SECRET=your-secret-key-here

GOPAY_CLIENT_ID=your-gopay-client-id
GOPAY_CLIENT_SECRET=your-gopay-client-secret
GOPAY_REDIRECT_URL=http://localhost:3000/api/auth/gopay/callback

# Stripe — produkční payment gateway. Bez STRIPE_SECRET_KEY checkout fallbackuje
# na mock GoPay redirect (/mock-gopay/<id>). Pro produkci nastav všechny tři.
# Webhook URL: https://<host>/api/payments/stripe/webhook
# Events: checkout.session.completed, charge.refunded, charge.dispute.created
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# SMTP — provider agnostic. Pro produkci doporučeno Resend nebo Postmark.
#
# Resend:    SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=re_xxxxx
# Postmark:  SMTP_HOST=smtp.postmarkapp.com, SMTP_USER=<server-token>, SMTP_PASS=<server-token>
# SendGrid:  SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<api-key>
# AWS SES:   SMTP_HOST=email-smtp.eu-central-1.amazonaws.com, SMTP_USER+SMTP_PASS=SMTP creds
# Dev:       SMTP_HOST=localhost, SMTP_PORT=1025 (MailHog, bez auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=vstupenky@tixly.local

# SMS — BulkGate (https://portal.bulkgate.com). Bez tokenů funguje jako mock (jen audit log).
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=
BULKGATE_SENDER_ID=Tixly
# BULKGATE_MOCK=1   # přinucené mock i s tokeny (pro testy)

# hCaptcha — bot/scalper protection v rizikových formulářích (checkout, register)
# Bez HCAPTCHA_SECRET server validaci přeskakuje (mock pass). Bez NEXT_PUBLIC_*
# klient widget se nerendruje. Pro produkci nastav oboje.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Web Push notifications (VAPID).
# Vygeneruj: `npx web-push generate-vapid-keys`
# Bez VAPID keys nebo bez `npm install web-push` server graceful fallback na log-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tixly.local

# CZ Benefit payment providers (volitelné — bez credentials běží mock).
# Real integrace vyžaduje vendor merchant account + whitelisted callback URL.
PLUXEE_MERCHANT_ID=
PLUXEE_API_KEY=
BENEFIT_PLUS_PARTNER_ID=
BENEFIT_PLUS_SECRET=
GALLERY_BETA_API_KEY=
EDENRED_MERCHANT_ID=
EDENRED_API_KEY=

NODE_ENV=development
DEBUG=false

# Vercel cron auth — Vercel automaticky vygeneruje, my jen ověřujeme v /api/cron/dispatch
CRON_SECRET=

# Internal service-to-service token (cron dispatcher → internal endpoints, mock GoPay webhook)
INTERNAL_SERVICE_TOKEN=

# AI moderation Claude API (bez tohoto se použije mock keyword regex)
ANTHROPIC_API_KEY=
MODERATION_PROVIDER=mock
MODERATION_AUTO_PUBLISH_DISABLED=1

# Google Wallet pass — bez Service Account vrací unsigned JWT (Google odmítne, frontend lze testovat)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
GOOGLE_WALLET_PRIVATE_KEY_PEM=

# Apple Wallet .pkpass — bez Pass Type ID certifikátu vrací unsigned bundle (iOS odmítne)
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_WWDR_CERT_PEM=

# Skryje "Demo vstupenka" warning v PDF lístku (nastav v produkci na '1')
TICKET_PDF_PRODUCTION_MODE=

# HMAC secret pro email verification + unsubscribe tokens (fallback na JWT_SECRET)
EMAIL_VERIFY_SECRET=
