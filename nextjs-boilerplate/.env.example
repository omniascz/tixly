NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres). Vercel deploy: použij Neon / Supabase / Vercel Postgres URL.
# Dev: docker compose up tixly-postgres (port 5433).
#
# DŮLEŽITÉ: pro produkci POUŽÍVAT `tixly_app` user, NE `tixly`!
#   - tixly       = SUPERUSER + BYPASSRLS — jen pro migrace + admin ops
#   - tixly_app   = NOSUPERUSER + NOBYPASSRLS — pro Next.js app connections
#                   → RLS policy z migrace 285 fungují pouze pro tixly_app.
#
# App runtime běží jako tixly_app = NESUPERUSER (Fáze 1 RLS/superuser nápravy,
# audit 2026-06-01). Kompromitace app tak neznamená cluster-admin přístup.
# Migrace/seedy/ops naopak používají superuser 'tixly' (potřebují pg_read_file aj.).
# BYPASSRLS na tixly_app je zatím ponechán (enforce RLS = Fáze 2, viz
# db/security-rls-report.md). V PRODUKCI nastav heslo přes secret, ne dev default.
DATABASE_URL=postgresql://tixly_app:tixly_app_dev@localhost:5433/tixly
# Ops/migrace/seed (superuser):
# DATABASE_URL_OPS=postgresql://tixly:tixly_dev@localhost:5433/tixly
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tixly
POSTGRES_USER=tixly
POSTGRES_PASSWORD=tixly_dev

# Redis — seat holds, queue tokens, rate limits.
# Vercel: použij Upstash URL z Marketplace.
REDIS_URL=redis://default:redis_dev@localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_dev

# Kafka — analytics events (volitelné v dev).
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=tixly

# JWT — auth tokens. V produkci vygeneruj 64-byte hex přes `openssl rand -hex 64`.
JWT_SECRET=replace-with-openssl-rand-hex-64
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# Symetrická šifra pro at-rest data (PSD2 tokeny, bank credentials).
# Generuj `openssl rand -hex 32` (32 bytes / 64 hex chars).
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# NextAuth (legacy — JWT_SECRET je primární).
NEXTAUTH_SECRET=your-secret-key-here

# Payment provider switching:
#   PAYMENT_PROVIDER=gopay|comgate|stripe|mock — globální default
#   PAYMENT_PROVIDER_EUR=gopay|comgate — explicit override pro EUR (SK promotéři)
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_EUR=

# GoPay — primární CZ provider. Vyžaduje merchant account na gopay.com.
# Bez GOPAY_GOID/CLIENT_ID/SECRET běží mock checkout (redirect /mock-gopay/<id>).
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_REDIRECT_URL=http://localhost:3000/api/auth/gopay/callback
GOPAY_MOCK=1

# ComGate — alternativní CZ/SK provider. Registrace na comgate.cz.
# Webhook URL: https://<host>/api/payments/comgate/webhook
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true

# Fio Bank Open API — bankovní výpisy (CZ).
FIO_API_TOKEN=

# Resend / Sentry (dedikované providery, nahrazují SMTP / Sentry SaaS).
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Stripe — produkční payment gateway. Bez STRIPE_SECRET_KEY checkout fallbackuje
# na mock GoPay redirect (/mock-gopay/<id>). Pro produkci nastav všechny tři.
# Webhook URL: https://<host>/api/payments/stripe/webhook
# Events: checkout.session.completed, charge.refunded, charge.dispute.created
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# SMTP — provider agnostic. Pro produkci doporučeno Resend nebo Postmark.
#
# Resend:    SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=re_xxxxx
# Postmark:  SMTP_HOST=smtp.postmarkapp.com, SMTP_USER=<server-token>, SMTP_PASS=<server-token>
# SendGrid:  SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<api-key>
# AWS SES:   SMTP_HOST=email-smtp.eu-central-1.amazonaws.com, SMTP_USER+SMTP_PASS=SMTP creds
# Dev:       SMTP_HOST=localhost, SMTP_PORT=1025 (MailHog, bez auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=vstupenky@tixly.local

# SMS — BulkGate (https://portal.bulkgate.com). Bez tokenů funguje jako mock (jen audit log).
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=
BULKGATE_SENDER_ID=Tixly
# BULKGATE_MOCK=1   # přinucené mock i s tokeny (pro testy)

# hCaptcha — bot/scalper protection v rizikových formulářích (checkout, register)
# Bez HCAPTCHA_SECRET server validaci přeskakuje (mock pass). Bez NEXT_PUBLIC_*
# klient widget se nerendruje. Pro produkci nastav oboje.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# Web Push notifications (VAPID).
# Vygeneruj: `npx web-push generate-vapid-keys`
# Bez VAPID keys nebo bez `npm install web-push` server graceful fallback na log-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tixly.local

# CZ Benefit payment providers (volitelné — bez credentials běží mock).
# Real integrace vyžaduje vendor merchant account + whitelisted callback URL.
PLUXEE_MERCHANT_ID=
PLUXEE_API_KEY=
BENEFIT_PLUS_PARTNER_ID=
BENEFIT_PLUS_SECRET=
GALLERY_BETA_API_KEY=
EDENRED_MERCHANT_ID=
EDENRED_API_KEY=

NODE_ENV=development
DEBUG=false

# Vercel cron auth — Vercel automaticky vygeneruje, my jen ověřujeme v /api/cron/dispatch
CRON_SECRET=

# Internal service-to-service token (cron dispatcher → internal endpoints, mock GoPay webhook)
INTERNAL_SERVICE_TOKEN=

# ── Moderace akcí (3 vrstvy + vision + lidská pojistka) ──────────────────────
# Vrstva 1: keyword blocklist (catalog.moderation_blocklist) — auto-reject známých termínů
# Vrstva 2: AI gate — text (title/popis/typy lístků) + VISION (plakát/cover image)
# Vrstva 3: lidská fronta /platform/event-moderation (master admin schválí/zamítne)
#
# ANTHROPIC_API_KEY: BEZ NĚJ běží jen mock regex a VISION moderace plakátu se
#   přeskočí (nelze "vidět" obrázek). V produkci NUTNÉ nastavit — jinak hákový
#   kříž na plakátu s čistým textem projde. Vision i text používají stejný klíč
#   a model (Claude Haiku).
ANTHROPIC_API_KEY=
MODERATION_PROVIDER=mock
# =1 → ŽÁDNÁ akce se nepublikuje automaticky; finální "publikovat" vždy klikne
#   master admin (AI/blocklist jen předtřídí). Doporučeno pro start. Na 0 přejdi
#   až budeš důvěřovat objemu — pak trusted promotéři (5+ akcí) publikují rovnou.
MODERATION_AUTO_PUBLISH_DISABLED=1

# Google Wallet pass — bez Service Account vrací unsigned JWT (Google odmítne, frontend lze testovat)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
GOOGLE_WALLET_PRIVATE_KEY_PEM=

# Apple Wallet .pkpass — bez Pass Type ID certifikátu vrací unsigned bundle (iOS odmítne)
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_WWDR_CERT_PEM=

# Skryje "Demo vstupenka" warning v PDF lístku (nastav v produkci na '1')
TICKET_PDF_PRODUCTION_MODE=

# HMAC secret pro email verification + unsubscribe tokens (fallback na JWT_SECRET)
EMAIL_VERIFY_SECRET=

# HMAC secret pro SMS vstupenku magic link (fallback na JWT_SECRET)
TICKET_MAGIC_SECRET=

# X.509 PAdES PDF signing — qualified certificate v PKCS#12 (.p12/.pfx) keystore.
# Base64-encoded P12 binary. Po podpisu Adobe Reader zobrazí platný digital
# signature. Pro produkci: PostSignum / I.CA / eIdentity kvalifikovaný cert.
# Bez tohoto env (nebo bez `npm install node-signpdf`) je PDF nepodepsaný.
PDF_SIGNING_P12_BASE64=
PDF_SIGNING_P12_PASSWORD=

# PSD2 OAuth2 bank credentials. Vyžaduje:
#   1. Registration na bank developer portal
#   2. eIDAS QWAC certificate (CZ banky)
#   3. Whitelisted redirect URL /api/admin/bank-credentials/psd2/callback
# Bez těchto env je flow disabled (vrací PROVIDER_NOT_CONFIGURED).
KB_PSD2_CLIENT_ID=
KB_PSD2_CLIENT_SECRET=
CS_PSD2_CLIENT_ID=
CS_PSD2_CLIENT_SECRET=
CSOB_PSD2_CLIENT_ID=
CSOB_PSD2_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# ForgeMsg integration (marketing/messaging platform)
# Outbox dispatcher POSTs ticketing events to ForgeMsg. Per-promoter API keys
# live in public.forgemsg_credentials; these are the platform-default fallback.
# -----------------------------------------------------------------------------
FORGEMSG_API_URL=https://api.forgemsg.cz
FORGEMSG_API_KEY=
FORGEMSG_PARTNER_SECRET=

# ARES (ověření IČO pořadatele) — kolo 7. Výchozí je veřejné API ares.gov.cz; testy míří na simulátor
# tests/helpers/fake-ares.mjs. Výpadek / timeout ARES přepne pořadatele do ručního ověření.
# ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty
# ARES_TIMEOUT_MS=5000
