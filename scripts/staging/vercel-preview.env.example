# Tixly — proměnné pro Vercel PREVIEW prostředí = staging (kolo 9 / krok 4).
# Nastavit ve Vercelu: Project → Settings → Environment Variables → prostředí „Preview" (ne Production).
# Pojistka: TIXLY_ENV=staging zapne src/lib/env/staging-guard.ts — server NENASTARTUJE, pokud DB nebo brána
# ukazuje na produkci (produkční Neon endpoint/projekt, app.tixly.cz, GoPay bez sandboxu, ComGate bez testu,
# Stripe/Mollie live klíče, PayPal/Triple-A bez sandboxu).

TIXLY_ENV=staging

# Databáze — ze staging.env, který vypíše scripts/staging/create.sh (samostatný Neon projekt)
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_URL_SUPER=
DATABASE_URL_OPS=

# Adresa stagingu (Vercel preview doména nebo vlastní, NE app.tixly.cz)
APP_URL=https://tixly-staging.vercel.app
NEXT_PUBLIC_APP_URL=https://tixly-staging.vercel.app

# Tajné klíče — vlastní pro staging (openssl rand -hex 32), NIKDY ne produkční
JWT_SECRET=
ENCRYPTION_KEY=
INTERNAL_SERVICE_TOKEN=
CRON_SECRET=
EMAIL_VERIFY_SECRET=
TICKET_MAGIC_SECRET=
HMAC_SECRET=

# Platby — jen sandbox
PAYMENT_PROVIDER=gopay
GOPAY_SANDBOX=true
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
COMGATE_TEST=true
COMGATE_MERCHANT=
COMGATE_SECRET=
# Stripe/PayPal/Mollie/Triple-A jen testovací klíče (sk_test_/pk_test_, *_SANDBOX=true, test_), nebo nenastavovat.

# E-mail — staging posílá přes RESEND skutečným lidem (Mailpit na stagingu není), proto POVINNÝ allowlist (kolo 10).
# Pojistka: s TIXLY_ENV=staging a prázdným (nebo neplatným) STAGING_EMAIL_ALLOWLIST server NENASTARTUJE.
# E-mail na adresu mimo allowlist se neodešle a zaloguje se ([mailer] staging: příjemci mimo STAGING_EMAIL_ALLOWLIST …).
# Formát: čárkou oddělené adresy nebo @domény; adresa pasuje i s plus-značkou (tester+cokoli@firma.cz).
STAGING_EMAIL_ALLOWLIST=tester@firma.cz
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# API klíč Resend pro staging (Resend → API Keys; ideálně samostatný klíč jen pro staging)
SMTP_PASS=
SMTP_SECURE=false
# Týž klíč: admin alerty (Resend HTTP API) a scripts/staging/smoke.sh (ověřuje doručení přes seznam odeslaných zpráv)
RESEND_API_KEY=
# Alerty adminovi jen na adresu z allowlistu (jinak se neodešlou)
PLATFORM_ADMIN_EMAIL=
# Odesílatel musí ležet na doméně ověřené v Resendu
EMAIL_FROM=Tixly STAGING <noreply@staging.tixly.cz>
MAIL_FROM=Tixly STAGING <noreply@staging.tixly.cz>

# Nedokončené cesty (kolo 10) — VYPNUTO, nenastavovat (zapíná jen hodnota 1; vkládá se při buildu → změna = nový deploy):
# NEXT_PUBLIC_FEATURE_INSTALLMENTS=   splátky + BNPL (Twisto, Skip Pay) — cron charge-installments bez Stripe značí splátky zaplacené
# NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=  předplatné / permanentky / abonentky — aktivace bez platby, renew bez platby
# NEXT_PUBLIC_FEATURE_BENEFIT_CARDS=  benefitní karty — chybí návratová URL po platbě

# Vstupenky se v testu značí jako demo (vodoznak) — TICKET_PDF_PRODUCTION_MODE nenastavovat
REDIS_URL=
