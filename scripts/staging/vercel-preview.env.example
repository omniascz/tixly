# Tixly — proměnné pro Vercel PREVIEW prostředí = staging (kolo 9 / krok 4).
# Nastavit ve Vercelu: Project → Settings → Environment Variables → prostředí „Preview" (ne Production).
# Pojistka: TIXLY_ENV=staging zapne src/lib/env/staging-guard.ts — server NENASTARTUJE, pokud DB nebo brána
# ukazuje na produkci (produkční Neon endpoint/projekt, app.tixly.cz, GoPay bez sandboxu, ComGate bez testu,
# Stripe/Mollie live klíče, PayPal/Triple-A bez sandboxu).

TIXLY_ENV=staging

# Databáze — ze staging.env, který vypíše scripts/staging/create.sh (samostatný Neon projekt)
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_URL_SUPER=
DATABASE_URL_OPS=

# Adresa stagingu (Vercel preview doména nebo vlastní, NE app.tixly.cz)
APP_URL=https://tixly-staging.vercel.app
NEXT_PUBLIC_APP_URL=https://tixly-staging.vercel.app

# Tajné klíče — vlastní pro staging (openssl rand -hex 32), NIKDY ne produkční
JWT_SECRET=
ENCRYPTION_KEY=
INTERNAL_SERVICE_TOKEN=
CRON_SECRET=
EMAIL_VERIFY_SECRET=
TICKET_MAGIC_SECRET=
HMAC_SECRET=

# Platby — jen sandbox
PAYMENT_PROVIDER=gopay
GOPAY_SANDBOX=true
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
COMGATE_TEST=true
COMGATE_MERCHANT=
COMGATE_SECRET=
# Stripe/PayPal/Mollie/Triple-A jen testovací klíče (sk_test_/pk_test_, *_SANDBOX=true, test_), nebo nenastavovat.

# E-mail — testovací schránka (např. hostovaný Mailpit nebo jiný SMTP sandbox), žádné doručování skutečným lidem
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Tixly STAGING <noreply@staging.example>
MAIL_FROM=Tixly STAGING <noreply@staging.example>

# Vstupenky se v testu značí jako demo (vodoznak) — TICKET_PDF_PRODUCTION_MODE nenastavovat
REDIS_URL=
