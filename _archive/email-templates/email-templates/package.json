{
  "name": "@tixly/email-templates",
  "version": "1.0.0",
  "description": "Professional HTML email templates for Tixly ticketing platform",
  "main": "src/email-renderer.ts",
  "types": "src/email-renderer.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write 'src/**/*.ts' '**/*.html'",
    "example": "ts-node examples/usage-examples.ts"
  },
  "keywords": [
    "email",
    "templates",
    "handlebars",
    "ticketing",
    "tixly",
    "mailgun",
    "sendgrid"
  ],
  "author": "Tixly s.r.o.",
  "license": "MIT",
  "dependencies": {
    "handlebars": "^4.7.7"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "mailgun.js": "^8.0.0",
    "form-data": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "mailgun.js": {
      "optional": true
    },
    "form-data": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
