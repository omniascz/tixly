# =============================================================================
# GoPay LIVE configuration template
# Copy to .env.production and fill in after GoPay approval.
#
# Prerequisites (block go-live until all ticked):
#   [ ] Promoter IČO registered with GoPay
#   [ ] GoPay merchant account approved (3–7 business days)
#   [ ] Production GOID issued
#   [ ] Production Client ID + Secret issued
#   [ ] Webhook URL whitelisted in GoPay admin
#   [ ] Webhook HMAC secret generated
#   [ ] EET certificate installed (Czech tax receipts)
#   [ ] Test payment via QR + card + bank transfer on staging
#   [ ] Refund flow tested on staging
# =============================================================================

# Environment flag — must be "production", never "test" in prod.
GOPAY_ENV=production

# GoPay merchant GOID (numeric, from GoPay admin)
GOPAY_GOID=

# OAuth client credentials (generated in GoPay admin)
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=

# API base URL for LIVE mode
GOPAY_API_URL=https://gate.gopay.cz/api

# Webhook (notification) settings
# URL must match what's whitelisted in GoPay admin
GOPAY_WEBHOOK_URL=https://tixly.cz/api/payments/gopay/webhook
# Shared secret used to verify webhook HMAC signatures
GOPAY_WEBHOOK_SECRET=

# Default callback URLs (returned to user after payment)
GOPAY_RETURN_URL=https://tixly.cz/checkout/return
GOPAY_NOTIFICATION_URL=https://tixly.cz/api/payments/gopay/webhook

# EET (Czech electronic records of sales)
GOPAY_EET_ENABLED=true
# Path to EET certificate (.p12), mounted as secret in production
GOPAY_EET_CERT_PATH=/run/secrets/eet_cert.p12
GOPAY_EET_CERT_PASSWORD=

# Currency (ISO 4217)
GOPAY_DEFAULT_CURRENCY=CZK

# Payment methods enabled in production
# Comma-separated: PAYMENT_CARD,BANK_ACCOUNT,GPAY,APPLE_PAY,QR_PLATBA
GOPAY_ALLOWED_PAYMENT_INSTRUMENTS=PAYMENT_CARD,BANK_ACCOUNT,QR_PLATBA

# Recurring payments (for season passes / permanentky)
GOPAY_RECURRENCE_ENABLED=true
