# E2E Smoke Test Environment Variables
# Copy this file to .env.local and fill in the values for your staging environment.

# Staging API base URL
BASE_URL=https://staging.tixly.cz

# Admin token with create:events, read:orders, read:tickets permissions
ADMIN_TOKEN=your-admin-token-here

# UUID of the test promoter account on staging
TEST_PROMOTER_ID=your-promoter-uuid-here

# UUID of a pre-existing ticket for wallet tests
TEST_TICKET_ID=your-ticket-uuid-here

# Set to "1" to enable GoPay sandbox payment flow
GOPAY_SANDBOX=1
